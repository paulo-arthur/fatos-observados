generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Perfil {
  ALUNO
  TENENTE
  CAPITAO
}

enum StatusFato {
  PENDENTE
  JULGADO
}

model Usuario {
  id           String   @id @default(uuid())
  nome         String
  email        String   @unique
  senhaHash    String
  perfil       Perfil
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  fatosComoAluno   FatoObservado[] @relation("AlunoParticipado")
  fatosComoOficial FatoObservado[] @relation("OficialParticipante")

  @@map("usuarios")
}

model FatoObservado {
  id           String     @id @default(uuid())
  motivo       String
  status       StatusFato @default(PENDENTE)
  data         DateTime   @db.Date
  hora         DateTime   @db.Time(0)
  criadoEm     DateTime   @default(now())
  atualizadoEm DateTime   @updatedAt

  alunoId   String
  aluno     Usuario @relation("AlunoParticipado", fields: [alunoId], references: [id])
  oficialId String
  oficial   Usuario @relation("OficialParticipante", fields: [oficialId], references: [id])

  @@index([alunoId])
  @@index([oficialId])
  @@map("fatos_observados")
}