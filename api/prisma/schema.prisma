generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Perfil {
  ALUNO
  TENENTE
  CAPITAO
}

enum StatusFato {
  PENDENTE
  JULGADO
}

model Usuario {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  senhaHash String
  perfil    Perfil
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())

  fatosComoAluno   FatoObservado[] @relation("AlunoParticipado")
  fatosComoOficial FatoObservado[] @relation("OficialParticipante")

  @@map("usuarios")
}

model FatoObservado {
  id     String     @id @default(uuid())
  motivo String
  status StatusFato @default(PENDENTE)
  data   DateTime   @db.Date
  hora   DateTime   @db.Time(0)

  alunoId   String
  aluno     Usuario @relation("AlunoParticipado", fields: [alunoId], references: [id])
  oficialId String
  oficial   Usuario @relation("OficialParticipante", fields: [oficialId], references: [id])

  @@index([alunoId])
  @@index([oficialId])
  @@map("fatos_observados")
}
